---
import { Image } from 'astro:assets';
import img1  from '../../assets/images/prendas/sueter.jpg'
import img2  from '../../assets/images/prendas/sueter2.jpg'
import img3  from '../../assets/images/prendas/chaqueta.png'
import img4  from '../../assets/images/prendas/sueter3.jpg'



const products = [
    { starts: "⭐⭐⭐⭐⭐",nombre: "Hoodie Negro", precio: 18, img: img1, alt: "Sudadera con capucha negra de estilo urbano y tejido grueso"},
    { starts: "⭐⭐⭐⭐⭐",nombre: "Sweater Verde Botella", precio: 20, img: img2, alt: "Sweater verde oscuro de cuello redondo y corte oversize"},
    { starts: "⭐⭐⭐⭐⭐",nombre: "Chaqueta Cargo Gris", precio: 25, img: img3, alt: "Chaqueta urbana gris con cierre de cremallera y bolsillos frontales estilo cargo."},
    { starts: "⭐⭐⭐⭐⭐",nombre: "Sweater Cuello Camel", precio: 21, img: img4, alt: "Sweater de cuello alto en tono camel con mangas largas ajustadas."}
]
---

<section id="destacados" class="flex flex-col px-6 py-2 gap-4 lg:gap-4 mt-6">
    <div class="w-full lg:mb-1 mb-4">
        <h2 class="font-montserrat text-accent font-bold text-[clamp(2.6rem,5vw,4.2rem)] leading-10">Piezas destacadas</h2>
        <p class="text-[1.35rem] mt-4 max-w-160">Entre nuestras colecciones, las piezas más destacadas entre nuestros clientes son las siguientes:</p>
    </div>
    <div class="w-full grid md:grid-cols-2 lg:grid-cols-4 gap-6 justify-center">
        {
            products.map((product) => (
                <article class="p-4 h-fit border-4 border-main rounded-md flex flex-col gap-2 bg-main text-background">
                        <div class="h-8/10 flex gap-4 items-center rounded-3xl overflow-hidden">
                            <Image 
                                class="w-fit object-contain"
                                src={product.img} 
                                alt={product.alt} 
                                width={500} 
                                height={600} 
                                draggable="false" 
                                loading="lazy"
                            />
                        </div>
                        <div>   
                            <h3 class="font-semibold text-[1.25rem]">{product.nombre}</h3>
                            <div class="flex gap-3 items-center">
                                <span class=" text-[1.25rem]">${product.precio}</span>
                                <span class="text-lg">{product.starts}</span>
                            </div>
                        </div>
                </article>
            ))
        }
    </div>
</section>