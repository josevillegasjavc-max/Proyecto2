---
import { Image } from 'astro:assets'
import logo from '../assets/images/logo.svg'

const enlaces = [
    {nombre: "Inicio", href: "/#"},
    {nombre: "Conocenos", href: "/#conocenos"},
    {nombre: "Cualidades", href: "/#cualidades"},
    {nombre: "Home", href: "/#"},
    {nombre: "Home", href: "/#"}
]

---
<header class="w-full min-h-16 flex text-accent py-1 px-10 fixed top-0 items-center justify-between bg-background z-10 flex-wrap rounded-b-2xl">
    <div class="max-w-7xl w-full mx-auto justify-between flex">
        <a class="h-12 w-36 my-1 select-none z-30" href="/#" aria-label="Inicio KROMA Studio">
            <Image
            src={logo} 
            alt="KROMA Studio Moda Urbana" 
            draggable="false" 
            loading="eager"
        />
        </a>
        <nav id="mainNav" class="flex flex-col items-center bg-background z-20 max-md:absolute max-md:right-0 max-md:w-40 max-md:rounded-3xl">
            <button 
                id="iconNav" class="text-5xl text-main mt-0.5 cursor-pointer select-none transition duration-300 ease-in-out hover:text-gray-700  md:hidden" aria-label="Abrir menú de navegación"
                aria-expanded="false"
                aria-controls="menuList"    
            >
                &#9776;
            </button>
                <ul id="menuList" class="font-medium hidden py-4 space-y-5 max-md:text-2xl items-center md:flex md:gap-10 md:space-y-0 ">
                    {
                        enlaces.map((item) => (
                            <li class="px-1 transition duration-800 ease-in-out hover:-translate-y-0.5 tracking-[2px]
                            relative after:content-[''] after:absolute after:bg-main after:rounded-full after:h-0.5 after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:transition-all after:duration-200 after:ease-in-out">
                                <a href={item.href}>{item.nombre}</a>
                            </li>
                        ))
                    }
                </ul>
        </nav>
    </div>
</header>

<script>
    const nav = document.querySelector("header");
    const iconNav = document.querySelector("#iconNav");
    const lista = document.querySelector("#menuList");

    iconNav?.addEventListener("click", () => {
        const isHidden = lista?.classList.toggle("hidden");
        nav?.classList.toggle("active");

        iconNav.setAttribute("aria-expanded", String(!isHidden));
    })
</script>