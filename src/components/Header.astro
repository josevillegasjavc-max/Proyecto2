---
import { Image } from 'astro:assets'
import logo from '../assets/images/logoKroma.png'

const enlaces = [
    {nombre: "Inicio", href: "/"},
    {nombre: "Home", href: "/"},
    {nombre: "Home", href: "/"},
    {nombre: "Home", href: "/"},
    {nombre: "Home", href: "/"}
]

---
<header class="h-16 flex text-accent py-1 px-10 fixed top-0 w-full justify-between bg-background shadow-[0px_4px_10px_#4444441c] z-10 flex-wrap">
    <a class="h-12 w-36 my-1 select-none drop-shadow-[0px_4px_50px_#10192ce8] z-30" href="/" aria-label="Inicio KROMA Studio">
        <Image
            src={logo} 
            alt="KROMA Studio Moda Urbana" 
            draggable="false" 
            loading="eager"
        />
    </a>
    <nav id="mainNav" class="bg-background flex flex-col items-center rounded-bl-2xl z-20">
        <button 
            id="iconNav" class="text-5xl text-main mt-0.5 cursor-pointer select-none transition duration-300 ease-in-out hover:text-gray-700  md:hidden" aria-label="Abrir menú de navegación"
            aria-expanded="false"
            aria-controls="menuList"    
        >
            &#9776;
        </button>
			<ul id="menuList" class="font-montserrat font-bold hidden py-4 space-y-4 items-center md:flex md:gap-10 md:space-y-0">
                {
                    enlaces.map((item) => (
                        <li class="font-bold px-2 py-0.5 transition duration-800 ease-in-out hover:-translate-y-0.5
                        relative after:content-[''] after:absolute after:bg-main after:rounded-full after:h-1 after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:transition-all after:duration-200 after:ease-in-out">
                            <a href={item.href}>{item.nombre}</a>
                        </li>
                    ))
                }
			</ul>
	</nav>
</header>

<script>
    const nav = document.querySelector("#mainNav");
    const iconNav = document.querySelector("#iconNav");
    const lista = document.querySelector("#menuList");
    iconNav?.addEventListener("click", () => {
        const isHidden = lista?.classList.toggle("hidden");
        nav?.classList.toggle("active");

        iconNav.setAttribute("aria-expanded", String(!isHidden));
    })
</script>

<style>
    @media (max-width: 767px) {
        .active {
            box-shadow: 0px 4px 10px #4444441c;
        }
    }
</style>